---
// src/components/CeremoniaCivil.astro
// La recepción: solo los datos. El diseño está en TarjetaLugar, el mismo
// de la ceremonia religiosa.
import TarjetaLugar from "./TarjetaLugar.astro";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Recepción Social";
const lugar = "Salón Jardines del Illimani";
const direccion = "Calle 21 de Achumani #380";
const hora = "19:00 hrs.";
// En la plantilla de muestra el botón no lleva a ningún lado ("#")
const enlaceMapa = "#";
const textoBoton = "Ver ubicación";
// ──────────────────────────────────────────────────────────────
---

<TarjetaLugar
    id="ceremonia-civil"
    titulo={titulo}
    icono="recepcion.png"
    lugar={lugar}
    direccion={direccion}
    hora={hora}
    enlaceMapa={enlaceMapa}
    textoBoton={textoBoton}
/>
